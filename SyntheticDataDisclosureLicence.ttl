@prefix odrl:  <http://www.w3.org/ns/odrl/2/> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix aimd:  <https://raw.githubusercontent.com/ci2me/AI-Model-Distribution-ODRL-Profile/main/AIMD.ttl#> .
@prefix aimd2: <https://raw.githubusercontent.com/aaykx/AI-Model-ODRL-Profile/main/AIMD_extended_v2.ttl#> .

# ─────────────────────────────────────────────────────────────────────────────
#  SyntheticDataDisclosureLicence  (Use Case 10)
#  Proprietary LLM teacher generates synthetic data → student open model
#  trained on synthetics. EU AI Act Recitals 107-110 + Art. 53(1)(c) require
#  GPAI providers to disclose ALL training data sources, including synthetic
#  data generated by a proprietary teacher. Phi-1 (Gunasekar 2023) and
#  Orca (Mukherjee 2023) are the landmark precedents.
#
#  Expected compliance result: ✗ if dataGenerationMethod is not declared in
#  the Art. 50/53 disclosure
#  Legal basis: EU AI Act Art. 53(1)(c); Recitals 107-110.
# ─────────────────────────────────────────────────────────────────────────────

<https://example.com/policy/SyntheticDataDisclosureLicence>
    a odrl:Policy, odrl:Set ;
    dct:title "Synthetic Data Disclosure Licence — Art. 53 GPAI Transparency for Synthetic Provenance" ;
    dct:description "AI models trained substantially on outputs of a proprietary teacher model (synthetic data) must declare the synthetic provenance in their Art. 53(1)(c) training content disclosure. Silent absorption of synthetically generated data into 'training data' without the teacher model attribution violates EU AI Act transparency obligations." ;
    dct:created "2026-06-30"^^xsd:date ;

    # ── PERMISSION: training on synthetic data with disclosure ───────────────
    odrl:permission [
        odrl:target   <https://example.com/assets/SyntheticCorpus> ;
        odrl:assigner <https://example.com/SyntheticDataProvider> ;
        odrl:action   aimd2:AITraining ;

        # dataGenerationMethod must be declared
        odrl:constraint [
            odrl:leftOperand  aimd2:dataGenerationMethod ;
            odrl:operator     odrl:isA ;
            odrl:rightOperand <https://raw.githubusercontent.com/aaykx/AI-Model-ODRL-Profile/main/AIMD_extended_v2.ttl#SyntheticFromProprietaryTeacher> ;
        ] ;

        # ── Obligations ───────────────────────────────────────────────────────
        odrl:duty [
            odrl:action aimd2:ComplyWithArticle50 ;  # must declare synthetic provenance
        ] ;
        odrl:duty [
            odrl:action aimd2:InheritSourceProhibitions ; # proprietary ToS restrictions survive
        ] ;
    ] ;

    # ── PROHIBITION: training without synthetic provenance disclosure ─────────
    odrl:prohibition [
        odrl:target  <https://example.com/assets/SyntheticCorpus> ;
        odrl:action  aimd2:AITraining ;
        odrl:constraint [
            odrl:leftOperand  aimd2:dataGenerationMethod ;
            odrl:operator     odrl:eq ;
            odrl:rightOperand <https://raw.githubusercontent.com/aaykx/AI-Model-ODRL-Profile/main/AIMD_extended_v2.ttl#UndeclaredSynthetic> ;
        ] ;
    ] ;

    aimd2:propagatesObligationTo <https://example.com/policy/SyntheticDataDisclosureLicence> .
