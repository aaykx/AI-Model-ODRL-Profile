dcat:MoEMergedDist12
    a dcat:Distribution, aimd:AIModelDistribution ;
    dct:title "MoE merged model — Llama obligation inheritance failure (UC-12)"@en ;
    dct:issued "2026-05-01"^^xsd:date ;
    dcat:accessURL <https://huggingface.co/moe-org/merged-uc12> ;
    dct:license <https://example.com/policy/OpenResearchLLMLicence> ;
    aimd:derivedFromDistribution dcat:ExpertADist12 ;
    aimd:derivedFromDistribution dcat:ExpertBDist12 ;
    aimd:derivedFromDistribution dcat:ExpertCDist12 ;
    aimd2:modelWeightsURL <https://huggingface.co/moe-org/merged-uc12> ;
    odrl:hasPolicy <https://example.com/policy/OpenResearchLLMLicence> ;
    prov:wasGeneratedBy [ a prov:Activity ;
        prov:used dcat:ExpertADist12 ;
        prov:used dcat:ExpertBDist12 ;
        prov:used dcat:ExpertCDist12 ] .

# propagatesObligationTo: ALL expert policies must propagate to the merged model
<https://example.com/policy/MoEMergedModelLicence>
    aimd2:propagatesObligationTo <https://example.com/policy/MoEMergedModelLicence> .

