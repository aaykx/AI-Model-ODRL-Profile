@prefix aimd2: <https://raw.githubusercontent.com/aaykx/AI-Model-ODRL-Profile/main/AIMD_extended_v2.ttl#> .
@prefix aimd:  <https://raw.githubusercontent.com/ci2me/AI-Model-Distribution-ODRL-Profile/main/AIMD.ttl#> .
@prefix odrl:  <http://www.w3.org/ns/odrl/2/> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix dcat:  <https://www.w3.org/ns/dcat#> .
@prefix prov:  <http://www.w3.org/ns/prov#> .

# ═══════════════════════════════════════════════════════════════════════════════
#  AIMD v2.0 — Use-Case Knowledge Graph
#  All 15 multi-hop licence chain instances as a single importable Turtle file.
#
#  Load order into GraphDB:
#   1. AIMD_extended.ttl       (Diya Mathew v3.0 — aimd: terms)
#   2. AIMD_extended_v2.ttl    (this dissertation — aimd2: terms)
#   3. AIMD_v2_knowledge_graph.ttl  (this file — instance data)
#
#  All 13 licence TTL files (OpenResearchLLMLicence.ttl, CommercialConflict
#  Licence.ttl, etc.) should also be imported so their ODRL policy triples
#  are available for SPARQL queries that follow odrl:hasPolicy links.
#
#  Diya's original distribution data (IrishLegalLLMDist1.5 etc.) is
#  populated by running server_v2.js. This file covers only the 15 new
#  UC-specific chain instances.
#
#  Chain notation in this file: each section shows the hop sequence then
#  the aimd2:propagatesObligationTo links that make obligations flow.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Top-level DCAT Catalog grouping all UC distributions ─────────────────────
<https://raw.githubusercontent.com/aaykx/AI-Model-ODRL-Profile/main/AIMD_v2_knowledge_graph.ttl>
    a dcat:Catalog ;
    dct:title "AIMD v2.0 Use Case Provenance Chains"@en ;
    dct:description "All 15 multi-hop AI model licence use case chains for the MAI dissertation (TCD 2026). Each chain demonstrates a distinct compliance scenario across the AIMD v2.0 profile."@en ;
    dct:creator <https://github.com/aaykx> ;
    dct:issued "2026-06-30"^^xsd:date ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcat:dataset
        dcat:OpenResearchLLMDist1 ,
        dcat:CommercialProductDist2 ,
        dcat:CopyleftViolatingModelDist3 ,
        dcat:PrematureRAGDist4 ,
        dcat:GPAIMultiSourceDist5 ,
        dcat:UnauthorisedDistillationDist6 ,
        dcat:MITStudentDist7 ,
        dcat:NetworkAPIDist8 ,
        dcat:RLHFAlignedDist9 ,
        dcat:OpenModelSyntheticDist10 ,
        dcat:GeneratorRAGDist11 ,
        dcat:MoEMergedDist12 ,
        dcat:ExecutorLLMDist13 ,
        dcat:GPAIAPIDist14 ,
        dcat:ConsumerProductDist15 .

# ═══════════════════════════════════════════════════════════════════════════════
# UC-1 — CC-BY Academic Corpus → Open Research LLM
# Chain: CCBYCorpusDist1 → OpenResearchLLMDist1
# Expected: ✓ COMPLIANT
# Legal basis: DSM Art. 3(1); CC-BY 4.0 §3(a); OSAID 1.0
# ═══════════════════════════════════════════════════════════════════════════════

dcat:CCBYCorpusDist1
    a dcat:Distribution, aimd:AIModelDistribution ;
    dct:title "CC-BY Academic Corpus (UC-1 source)"@en ;
    dct:issued "2026-01-01"^^xsd:date ;
    dcat:accessURL <https://tara.tcd.ie/uc1-corpus> ;
    dct:license <https://example.com/policy/OpenResearchLLMLicence> ;
    aimd2:actorType "research" ;
    aimd2:trainingDatasetURL <https://tara.tcd.ie/uc1-corpus> ;
    odrl:hasPolicy <https://example.com/policy/OpenResearchLLMLicence> .

dcat:OpenResearchLLMDist1
    a dcat:Distribution, aimd:AIModelDistribution ;
    dct:title "Open Research LLM — OSAID-compliant (UC-1)"@en ;
    dct:issued "2026-03-01"^^xsd:date ;
    dcat:accessURL <https://huggingface.co/openresearch/llm-uc1> ;
    dct:license <https://example.com/policy/OpenResearchLLMLicence> ;
    aimd:derivedFromDistribution dcat:CCBYCorpusDist1 ;
    aimd2:trainingDatasetURL <https://tara.tcd.ie/uc1-corpus> ;
    aimd2:modelWeightsURL <https://huggingface.co/openresearch/llm-uc1> ;
    aimd2:downstreamLicenceURI <https://example.com/policy/OpenResearchLLMLicence> ;
    aimd2:article50PolicyURL <https://openresearch.example.com/art50/uc1> ;
    aimd2:actorType "research" ;
    odrl:hasPolicy <https://example.com/policy/OpenResearchLLMLicence> ;
    prov:wasGeneratedBy [ a prov:Activity ; prov:used dcat:CCBYCorpusDist1 ] .

# propagatesObligationTo: CC-BY attribution must flow to all downstream policies
<https://example.com/policy/OpenResearchLLMLicence>
    aimd2:propagatesObligationTo <https://example.com/policy/OpenResearchLLMLicence> .

